# Get your API key here - https://e2b.dev/
E2B_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Other providers
# Multi-model tournament: Gemini (GOOGLE_GENERATIVE_AI_API_KEY) and NVIDIA NIM
# (NVIDIA_API_KEY) candidates join the battle when set; otherwise slots fall back to OpenAI.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_VERTEX_CREDENTIALS=
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
MISTRAL_API_KEY=
XAI_API_KEY=

# Morph fast-apply for edits (optional)
MORPH_API_KEY=
# NEXT_PUBLIC_USE_MORPH_APPLY=

### Optional env vars

# Domain of the site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=

# Rate limit
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW=

# Vercel/Upstash KV (short URLs, rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Clerk (auth) — both required to build projects: every LLM, sandbox and
# platform route needs a signed-in user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

### EvoStack platform (per-project backends + control centers)

# Where each project's isolated SQLite database lives (default: ./.data/platform)
# EVOSTACK_PLATFORM_DIR=
# Trust x-vercel-forwarded-for / x-real-ip for public rate limits (automatic on Vercel)
# EVOSTACK_TRUSTED_PROXY=1

### Images in generated sites (evo-image:// placeholders)

# ai (default when OPENAI_API_KEY is set) | stock | hybrid — AI photos fall back to stock, then a placeholder
# EVOSTACK_IMAGE_MODE=ai
# Model chain, first that works wins (default: gpt-image-2.6-flare,gpt-image-1-mini)
# EVOSTACK_IMAGE_MODELS=
# low | medium | high (default medium)
# EVOSTACK_IMAGE_QUALITY=medium
# Total image budget per preview in ms (default 60000) and per-image AI window (default 20000)
# EVOSTACK_IMAGE_BUDGET_MS=
# EVOSTACK_IMAGE_TIMEOUT_MS=
# Paid AI images per user / per server per hour (defaults 120 / 1500)
# EVOSTACK_IMAGE_USER_HOURLY=
# EVOSTACK_IMAGE_GLOBAL_HOURLY=
# Disk cache for generated images (default ./.data/image-cache, gitignored)
# EVOSTACK_IMAGE_CACHE_DIR=

### Development only — ignored when NODE_ENV=production

# Act as this user without Clerk sign-in (local / headless testing).
# Never expose a dev server with these set.
# EVOSTACK_DEV_USER=
# NEXT_PUBLIC_EVOSTACK_DEV_USER=

# Supabase (legacy, unused)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostHog (analytics) — only starts when NEXT_PUBLIC_ENABLE_POSTHOG is set
# NEXT_PUBLIC_ENABLE_POSTHOG=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

### Disabling functionality (when uncommented)

# Disable API key and base URL input in the chat
# NEXT_PUBLIC_NO_API_KEY_INPUT=
# NEXT_PUBLIC_NO_BASE_URL_INPUT=

# Hide local models from the list of available models
# NEXT_PUBLIC_HIDE_LOCAL_MODELS=
