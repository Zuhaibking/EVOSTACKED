# Get your API key here - https://e2b.dev/
E2B_API_KEY=

# ---- Paid OpenAI (Asta models) ----
OPENAI_API_KEY=

# ---- Free cloud providers (server-side only; never expose to the browser) ----
# Google Gemini (@ai-sdk/google). Prefer GOOGLE_GENERATIVE_AI_API_KEY (SDK default).
# GOOGLE_AI_API_KEY is also accepted by EvoStack for compatibility.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_AI_API_KEY=

GROQ_API_KEY=
CEREBRAS_API_KEY=

# NVIDIA Integrate API (OpenAI-compatible: https://integrate.api.nvidia.com/v1)
# Server-side only — never use NEXT_PUBLIC_* for these keys.
# Optional second credential for the same NVIDIA provider (quota/load sharing).
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=

# GitHub Models (OpenAI-compatible: https://models.github.ai/inference)
# Prefer a PAT / fine-grained token with models:read as GITHUB_MODELS_TOKEN.
GITHUB_MODELS_TOKEN=
# Fallback accepted by the resolver (e.g. Actions GITHUB_TOKEN):
# GITHUB_TOKEN=

MISTRAL_API_KEY=

# ---- Other optional providers ----
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
GOOGLE_VERTEX_CREDENTIALS=
XAI_API_KEY=
DEEPSEEK_API_KEY=

### Optional env vars

# Domain of the site
NEXT_PUBLIC_SITE_URL=

# Rate limit
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW=

# Vercel/Upstash KV (short URLs, rate limiting)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase (auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

### Disabling functionality (when uncommented)

# Disable API key and base URL input in the chat
# NEXT_PUBLIC_NO_API_KEY_INPUT=
# NEXT_PUBLIC_NO_BASE_URL_INPUT=

# Hide local-only models (Ollama / OmniRoute) from the selector.
# On Vercel production/preview, local models are also hidden automatically.
# NEXT_PUBLIC_HIDE_LOCAL_MODELS=1

# ---- Local development only (DO NOT set on Vercel) ----
# OmniRoute / OpenAI-compatible local gateways can be used via the chat
# baseURL field in development, e.g. http://127.0.0.1:20128/v1
# Production rejects localhost / private-network base URLs.
