    "@ai-sdk/mistral": "^1.0.1",
    "@ai-sdk/openai": "^1.3.24",
    "@clerk/backend": "^2.29.0",
    "@e2b/code-interpreter": "^1.0.2",
    "@evostack/shared": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.1",
    "@vercel/kv": "^2.0.0",
