{
  "name": "@evostack/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma migrate deploy && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json --noEmit",
    "start": "prisma migrate deploy && tsx src/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:new": "node scripts/create-migration.mjs"
  },
