{
  "name": "evostack-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @evostack/app --filter @evostack/api dev",
    "dev:web": "pnpm --filter @evostack/app dev",
    "dev:api": "pnpm --filter @evostack/api dev",
    "build": "pnpm --filter @evostack/shared build && pnpm --filter @evostack/api build && pnpm --filter @evostack/app build",
    "test": "pnpm --filter @evostack/api test && pnpm --filter @evostack/app test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @evostack/api prisma:migrate",
    "lint": "pnpm --filter @evostack/app lint && pnpm --filter @evostack/api lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@clerk/shared",
      "core-js",
      "unrs-resolver"
    ]
  }
}
